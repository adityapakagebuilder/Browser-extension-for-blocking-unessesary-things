{
  "manifest_version": 3,
  "name": "Promo Shield",
  "short_name": "Promo Shield",
  "version": "1.0.0",
  "description": "Blocks ads and promos on the web and clears promo emails from Gmail, while keeping your verification codes.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Promo Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "sidePanel",
    "identity",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://gmail.googleapis.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://mail.google.com/*"],
      "js": ["content/cosmetic.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["lib/classifier.js", "content/gmail.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "624576384692-hn6nufkoqqqpu36nq8qmh0ivl54tddgp.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.modify"]
  }
}
